{
  "name": "internship-portal-api",
  "version": "1.0.0",
  "description": "Student Internship Portal - Node.js + Express + React + MongoDB",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "nodemon app.js",
    "develop": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm --prefix client run build",
    "setup": "npm install && npm --prefix client install",
    "test": "node -e \"console.log('No automated test suite configured'); process.exit(0);\""
  },
  "keywords": [
    "internship-portal",
    "mern",
    "express",
    "react",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
